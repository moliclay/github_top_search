# ===== 大模型接口 =====
# OpenAI 兼容接口，通常以 /v1 结尾
LLM_BASE_URL=http://127.0.0.1:8788/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-v4.1-flash

# DeepSeek 官方接口示例：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ===== 本地代理自动拉起（可选）=====
# 不使用本地代理时保持为空并关闭自动拉起
LLM_PROXY_DIR=
LLM_PROXY_AUTOSTART=false

# workbuddy 代理示例：
# LLM_PROXY_DIR=C:\path\to\workbuddy\wb-proxy
# LLM_PROXY_AUTOSTART=true

# ===== 采集与调度 =====
TOP_N=10
SCHEDULE_TIME=09:00
TASK_NAME=GitHubDailyTrending
GITHUB_TRENDING_URL=https://github.com/trending?since=daily

# ===== 可选参数 =====
# REQUEST_TIMEOUT=20
# LLM_TIMEOUT=60
# MAX_SUMMARY_CHARS=30
